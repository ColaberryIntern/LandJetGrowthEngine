FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY tsconfig.json ./
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY docs/ ./docs/
COPY .sequelizerc ./

RUN npx tsc

EXPOSE 3001

CMD ["sh", "-c", "npx sequelize-cli db:migrate && node dist/server.js"]
