FROM node:22-alpine

# Fonts for server-side SVG->PNG chart rasterization (sharp/librsvg). Without a
# font package, Alpine has zero fonts and librsvg renders every text label as
# tofu squares -- which is exactly what showed up in the Friday briefing charts.
# DejaVu covers Latin + digits + the symbols our charts use; fontconfig is the
# resolver librsvg queries.
RUN apk add --no-cache fontconfig ttf-dejavu && fc-cache -f

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY tsconfig.json ./
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY docs/ ./docs/
COPY .sequelizerc ./

RUN npx tsc

EXPOSE 3001

CMD ["sh", "-c", "npx sequelize-cli db:migrate && node dist/server.js"]
